# ScoutAI environment variables
# Copy to .env.local for local dev and fill in real values.
# Never commit .env.local or any file containing real credentials.

# --- Parallel Search API ---
# https://parallel.ai
PARALLEL_API_KEY=

# --- Supabase (durable scout-run state) ---
# Project Settings -> API in your Supabase dashboard.
# Public/anon key by design — rows are keyed by an unguessable uuid.
# See src/lib/scoutRunStore.ts for why the anon key is safe here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Internal stage-route auth ---
# Any long random string (e.g. `openssl rand -hex 32`). Protects the
# internal /api/scout/stage-* routes from being called directly by
# anyone who finds the URL. See src/lib/internalAuth.ts.
INTERNAL_STAGE_SECRET=

# --- Google Cloud Vertex AI (Gemini) ---
# LOCAL DEV: leave the GCP_* vars below empty. Auth is handled by
# Application Default Credentials instead — run:
#   gcloud auth application-default login
# and set only these two:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# PRODUCTION (Vercel only): Workload Identity Federation. Vercel
# exchanges its own OIDC token for short-lived GCP credentials that
# impersonate a dedicated service account — no downloadable key file.
# Leave these unset for local dev. See src/lib/agent.ts for the full
# rationale.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# --- Not needed here ---
# VERCEL_URL is set automatically by Vercel at runtime — do not set
# it yourself.
