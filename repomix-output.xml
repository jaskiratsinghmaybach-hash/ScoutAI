                                                                                <p key={li} className="mb-2.5 font-medium leading-relaxed text-foreground">
                                                                                    {trimmed}
                                                                                </p>
                                                                            );
                                                                        })}
                                                                    </div>
                                                                </div>
                                                            )}
                                                        </div>
                                                    )
                                                )}
