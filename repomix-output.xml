  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
}

/**
 * The app's own layout (ScoutApp's `h-screen flex` panels) is already
 * fully self-contained and internally scrollable — every place content
 * can overflow has its own `overflow-y-auto`. This html/body rule
 * exists purely as a hard backstop: without it, if ANY content
 * anywhere (a long chat message, a card mid-animation, a future
 * addition) ever pushes past 100vh, the browser silently adds its own
 * page-level scrollbar in both directions instead of the intended
 * inner-panel one. Capping html/body here means that can never happen
 * — the page itself is never scrollable, only the panels inside it.
 */
html,
body {
  height: 100%;
  overflow: hidden;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans), system-ui, sans-serif;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

* {
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

*::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background-color: var(--border);
  border-radius: 0;
}

*::-webkit-scrollbar-thumb:hover {
  background-color: var(--foreground-muted);
}

*::-webkit-scrollbar-corner {
  background: transparent;
}

*::-webkit-scrollbar-button {
  display: none;
  width: 0;
  height: 0;
}


/* 1. Global selection highlight style (Dark Grey) */
::selection {
  background-color: #333333; /* Dark grey highlight */
  color: #ffffff;            /* Crisp white text */
}

::-moz-selection {
  background-color: #333333;
  color: #ffffff;
}

/* 2. Disable text selection app-wide by default */
html, body, * {
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

/* 3. Disable media element dragging */
img, svg, video, a {
  -webkit-user-drag: none;
  -khtml-user-drag: none;
  -moz-user-drag: none;
  -o-user-drag: none;
}

/* 4. Re-enable selection ONLY for user inputs, textareas, chat content, and explicit classes */
input,
textarea,
[contenteditable="true"],
.selectable,
.chat-message,
.message-content {
  -webkit-user-select: text !important;
  -moz-user-select: text !important;
  -ms-user-select: text !important;
  user-select: text !important;
}
/* Fix textareas height and disable resizing */
textarea {
  resize: none;
  overflow-y: auto;
}

@keyframes shimmer-sweep {
  0% { background-position: 0% 0%; }
  100% { background-position: 200% 200%; }
}

.animate-shimmer-sweep {
  animation: shimmer-sweep 2.5s ease-in-out infinite;
}

/**
 * Slim scrollbar variant — same color/shape language as the global
 * scrollbar above (border color, square corners, hover state), just
 * thinner. Used for internal-scroll areas in the results panel (tab
 * content pane, stats column, run history dropdown) where the default
 * 10px width would look heavy against smaller, denser containers.
 */
.scrollbar-thin {
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.scrollbar-thin::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

.scrollbar-thin::-webkit-scrollbar-track {
  background: transparent;
}

.scrollbar-thin::-webkit-scrollbar-thumb {
  background-color: var(--border);
  border-radius: 0;
}

.scrollbar-thin::-webkit-scrollbar-thumb:hover {
  background-color: var(--foreground-muted);
}

.scrollbar-thin::-webkit-scrollbar-corner {
  background: transparent;
}
